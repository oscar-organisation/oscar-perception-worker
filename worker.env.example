# API centrale OSCAR. La clé doit être identique à PERCEPTION_WORKER_API_KEY
# côté Admin API et doit être injectée par le gestionnaire de secrets.
OSCAR_CENTRAL_API_URL=https://admin.oscar-bot.com
OSCAR_PERCEPTION_WORKER_KEY=replace-with-a-random-secret
OSCAR_ROBOT_ID=replace-with-the-central-api-robot-id

OSCAR_MODEL_CACHE=/var/lib/oscar/models
OSCAR_MANIFEST_REFRESH_SECONDS=10

# Chemin média vers le SFU. À définir dès que le worker tourne sur le même hôte
# que LiveKit : le nom public fait aboutir la signalisation sans jamais établir
# le média, donc sans jamais recevoir de piste. Le jeton reste émis par l'API.
# OSCAR_LIVEKIT_URL=ws://oscar-livekit-server:7880

# Surcharge de développement uniquement : court-circuite la demande de session.
# Définir les deux à la fois.
# OSCAR_LIVEKIT_URL=wss://stream-livekit.oscar-bot.com
# OSCAR_LIVEKIT_TOKEN=replace-with-a-short-lived-token

# Zones de l'image ignorees, en coordonnees normalisees x1,y1,x2,y2 separees par
# « ; ». Sert a masquer ce que la camera voit du robot lui-meme (pince, capot).
# Une detection est retiree si au moins OSCAR_EXCLUSION_OVERLAP de sa surface
# tombe dans une zone. Exemple : bande basse occupee par la pince.
# OSCAR_EXCLUSION_ZONES=0,0.72,1,1
# OSCAR_EXCLUSION_OVERLAP=0.6
